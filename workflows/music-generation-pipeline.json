"name": "is_enable", "type": "BOOLEAN", "widget": {"name": "is_enable"}, "link": null}], "outputs": [{"localized_name": "any", "name": "any", "type": "*", "links": [52]}], "properties": {"cnr_id": "comfyui_llm_party", "ver": "3978924240ffe96042d9ff33ee901a638b2e4585", "Node name for S&R": "json_get_value"}, "widgets_values": ["key", true]}, {"id": 19, "type": "UNETLoader", "pos": [746.6925783783907, -265.05271542698176], "size": [270, 82], "flags": {}, "order": 6, "mode": 0, "inputs": [{"localized_name": "unet_name", "name": "unet_name", "type": "COMBO", "widget": {"name": "unet_name"}, "link": null}, {"localized_name": "weight_dtype", "name": "weight_dtype", "type": "COMBO", "widget": {"name": "weight_dtype"}, "link": null}], "outputs": [{"localized_name": "MODEL", "name": "MODEL", "type": "MODEL", "links": [13]}], "properties": {"cnr_id": "comfy-core", "ver": "0.13.0", "Node name for S&R": "UNETLoader"}, "widgets_values": ["flux2-dev.safetensors", "default"]}, {"id": 5, "type": "show_text_party", "pos": [-457.1943892287035, -547.303788408226], "size": [430.15800000000013, 342.20000000000005], "flags": {}, "order": 13, "mode": 0, "inputs": [{"localized_name": "text", "name": "text", "type": "STRING", "link": 3}], "outputs": [{"localized_name": "STRING", "name": "STRING", "shape": 6, "type": "STRING", "links": null}], "properties": {"cnr_id": "comfyui_llm_party", "ver": "3978924240ffe96042d9ff33ee901a638b2e4585", "Node name for S&R": "show_text_party"}, "widgets_values": ["{\n  \"tags\": \"retro synth-pop, wistful, airy female vocals, gated reverb snare, shimmering electric guitar, analog tape saturation, 88 bpm, key of Ab major, warm vintage sheen, vocal-forward mix\",\n  \"lyrics\": \"[Verse 1]\\nYou open up the heavy door\\nBut leave me standing in the shade\\nI watch your happy moments pass\\nA shadow in the afternoon parade\\nThe coffee steam begins to rise\\nWhile I pretend I'm not surprised\\n\\n[Pre-Chorus]\\nCan you feel me breathing near?\\nOr am I just a ghost of fear?\\n\\n[Chorus - wistful]\\nI am always there for you\\nBut you look so far from me\\nI am always there for you\\nStanding where the light will be\\n\\n[Verse 2]\\nWalking past the empty seats\\nYou're smiling at your old dreams\\nMy name is spoken in the air\\nBut never quite to meet my stare\\nThe night is cold and quiet here\\nAnd I am holding back a tear\\n\\n[Bridge - whispered]\\nIs it wrong to want your love?\\nCan a friend ever be enough?\\nI am just background noise\\nIn the middle of your life\\n\\n[Chorus - powerful]\\nI am always there for you\\nBut you look so far from me\\nI am always there for you\\nStanding where the light will be\\n\\n[Outro]\\nI will always be there for you\",\n  \"image_prompt\": \"A lonely young woman in an oversized vintage trench coat standing under a street lamp in a retro-futuristic cityscape. The scene is drenched in soft amber and teal lighting, suggesting twilight with synthwave colors bleeding into the background. Neon signs blur in the distance behind a glass barrier. Palm trees silhouette against glowing purple skies. The mood is contemplative and cinematic with visible film grain texture, evoking an 80s anime aesthetic. The composition uses depth of field to isolate her figure while warm bokeh lights frame the edges of the shot. No text or instruments visible in the scene.\",\n  \"video_title\": \"Always There For You\",\n  \"key\": \"Ab major\",\n  \"time_signature\": 4,\n  \"bpm\": 88\n}"]}, {"id": 2, "type": "LLM_api_loader", "pos": [-1257.874780137797, -356.8044718793002], "size": [270, 130], "flags": {"collapsed": false}, "order": 7, "mode": 0, "inputs": [{"localized_name": "model_name", "name": "model_name", "type": "STRING", "widget": {"name": "model_name"}, "link": null}, {"localized_name": "base_url", "name": "base_url", "shape": 7, "type": "STRING", "widget": {"name": "base_url"}, "link": null}, {"localized_name": "api_key", "name": "api_key", "shape": 7, "type": "STRING", "widget": {"name": "api